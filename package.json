{
  "name": "ocode2tpsmeter",
  "version": "0.2.4",
  "description": "Live TPS meter for OpenCode2 — centered in the prompt footer status",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "src",
    "dist",
    "index.ts",
    "tui.ts",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaanyaren/Opencode2TPS.git"
  },
  "opencode": {
    "tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.20"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.20",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0"
  }
}
